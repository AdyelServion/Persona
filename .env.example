# Copy to .env for local development. Never commit .env.

# Required
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=Personality
DB_NAME=Sarah
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# Optional local tunnel
NGROK_KEY=

# Optional overrides
DEFAULT_PERSONA_ID=sarah_taylor_001
DEFAULT_USER_ID=local-user
FASTAPI_BASE_URL=http://127.0.0.1:8001
FASTAPI_PORT=8001
DJANGO_PORT=8000
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=

# Set true only for a one-off first deploy if Mongo has no persona data yet
RUN_INGEST_ON_START=false

# Shared secret between the Django proxy and FastAPI (required in production)
INTERNAL_API_TOKEN=
MAX_USERS_PER_BROWSER=25

# Proactive outbound (Sarah messaging first) — users must also opt in individually
PROACTIVE_OUTBOUND_ENABLED=false
PROACTIVE_MAX_PER_HOUR=2
PROACTIVE_MAX_PER_DAY=8
PROACTIVE_MAX_PER_WEEK=28
PROACTIVE_MIN_GAP_MINUTES=5
PROACTIVE_MIN_GAP_HOURS=20
PROACTIVE_QUIET_START=22:00
PROACTIVE_QUIET_END=08:00
PROACTIVE_SCAN_MINUTES=2
PROACTIVE_INTERVAL_JITTER_RATIO=0.15
PROACTIVE_UNANSWERED_COOLDOWN_HOURS=6
PROACTIVE_MAX_CONSECUTIVE_INITIATIONS=3
PROACTIVE_ANALYZE_RECENT_MESSAGES=10
PROACTIVE_MAX_BUBBLES=3
PROACTIVE_JOB_TTL_HOURS=6
# in_app (UI polling) or test (records only, sends nothing)
PROACTIVE_DELIVERY=in_app

# Turns Sarah keeps leading after the user answers her message
SARAH_LED_TURNS=4
# false = normal replies skip the simulated "busy" delays (proactive is never delayed)
REALISTIC_REPLY_DELAYS=true
